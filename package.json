{
  "name": "celestia",
  "version": "0.1.0",
  "description": "N-body celestial physics simulation — WebGPU + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "catalog:exoplanets": "node scripts/build-exoplanet-hosts.mjs",
    "catalog:stars": "node scripts/build-visible-stars.mjs",
    "cache:horizons": "node scripts/cache-horizons.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.70",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
